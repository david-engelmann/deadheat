{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/deadheat/main/schemas/championship.schema.json",
  "title": "Deadheat Championship File (v1)",
  "description": "Version 1 championship manifest referencing series file paths for all thirty championship commands.",
  "type": "object",
  "required": [
    "series"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    }
  }
}
