{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/deadheat/main/schemas/series.schema.json",
  "title": "Deadheat Series File (v1)",
  "description": "Version 1 first-to-N race series read by deadheat series and flip.",
  "type": "object",
  "required": [
    "task",
    "wins_target",
    "models",
    "races"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "wins_target": {
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]+$"
      }
    },
    "races": {
      "type": "array",
      "items": {
        "$ref": "race.schema.json"
      }
    }
  }
}
