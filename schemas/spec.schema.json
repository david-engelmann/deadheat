{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/deadheat/main/schemas/spec.schema.json",
  "title": "Deadheat Race Specification (v1)",
  "description": "Version 1 local duel specification read by deadheat run.",
  "type": "object",
  "required": [
    "task",
    "workspace",
    "record",
    "attempts"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "string",
      "minLength": 1
    },
    "attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "model",
          "environment",
          "command"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
